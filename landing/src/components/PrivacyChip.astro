---
const { label } = Astro.props;
---
<div class="glass-subtle rounded-lg px-4 py-2.5 text-base-300 text-[13px] font-medium flex items-center justify-center gap-2">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-tier-strong">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
  {label}
</div>
