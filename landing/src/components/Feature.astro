---
const { title, desc } = Astro.props;
---
<div class="glass-subtle feature-card rounded-xl p-7 hover:bg-white/[0.04]">
  <h3 class="text-base font-semibold tracking-tight text-base-50 mb-2.5 flex items-center gap-2.5">
    <span class="w-1 h-4 rounded-full bg-gradient-to-b from-accent-400 to-accent-700"></span>
    {title}
  </h3>
  <p class="text-sm text-base-300 leading-relaxed">{desc}</p>
</div>
