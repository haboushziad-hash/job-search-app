---
// Base HTML shell. Sets up <head> with preloaded font + critical metadata.
const { title = "Find me some damn jobz", description = "AI-powered job search that actually fits. Local-first, private, multi-industry. Built for people who don't want to spam-apply.", canonical = "https://findmesomedamnjobz.com/" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonical} />

    <!-- Geist Variable preload — uncomment after dropping the .woff2 file
         into public/fonts/. Until then the system stack renders instantly
         (font-display: swap) so there's no FOIT either way. -->
    <!--
    <link rel="preload" href="/fonts/Geist-Variable.woff2"
          as="font" type="font/woff2" crossorigin />
    -->

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#0c0e14" />
  </head>
  <body>
    <!-- Background mesh + grain (z-index: -2 and -1, fixed-position) -->
    <div class="mesh" aria-hidden="true">
      <div class="blob"></div>
    </div>
    <div class="noise" aria-hidden="true"></div>

    <slot />

    <!-- Tiny script: scroll-reveal via IntersectionObserver. ~15 lines, no library. -->
    <script>
      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
      );
      document
        .querySelectorAll(".reveal, .reveal-stagger")
        .forEach((el) => obs.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
