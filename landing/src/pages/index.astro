---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stat from "../components/Stat.astro";
import Step from "../components/Step.astro";
import Feature from "../components/Feature.astro";
import PrivacyChip from "../components/PrivacyChip.astro";

// Production downloads stream through the Cloudflare Worker, which checks
// the request Origin/Referer is findmesomedamnjobz.com before serving the
// .msi/.dmg from a private R2 bucket. The bare URLs are not directly
// shareable — pasting them into a fresh tab returns 403.
const MSI_URL = import.meta.env.PUBLIC_MSI_URL || "https://api.findmesomedamnjobz.com/v1/dl/windows";
const DMG_ARM64_URL = import.meta.env.PUBLIC_DMG_ARM64_URL || "https://api.findmesomedamnjobz.com/v1/dl/mac-arm64";
const DMG_X64_URL = import.meta.env.PUBLIC_DMG_X64_URL || "https://api.findmesomedamnjobz.com/v1/dl/mac-x64";
const VERSION = "0.2.3";
const APP_SIZE = "107 MB";
---
<BaseLayout>
  <!-- ======================================================== HERO -->
  <header class="relative overflow-hidden">
    <!-- Cursor spotlight — soft purple glow that tracks the mouse position
         behind the hero. Visual position is set via CSS vars --mx and --my
         updated by the script at the bottom of this file. Falls back to
         hidden when JS is off. -->
    <div id="hero-spotlight" class="cursor-spotlight" aria-hidden="true"></div>
    <!-- Top nav -->
    <nav class="max-w-6xl mx-auto px-6 pt-8 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <!-- Z mark — cleaned PNG (real transparency, auto-cropped to its
             alpha bbox so the logo fills the canvas without dead padding). -->
        <img src="/z-mark.png" alt="findmesomedamnjobz" width="32" height="32" />
        <span class="font-semibold tracking-tight text-base-100 text-sm">findmesomedamnjobz</span>
      </div>
      <div class="hidden sm:flex items-center gap-1">
        <a href="#how-it-works" data-nav-target="how-it-works" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">How it works</a>
        <a href="#features" data-nav-target="features" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">Features</a>
        <a href="#privacy" data-nav-target="privacy" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">Privacy</a>
      </div>
      <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;"
         class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-white/[0.06] border border-white/[0.08] text-sm text-base-100 hover:bg-white/[0.10] transition-colors">
        Download
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>

    <!-- Built-by credit (animated gradient) — placed just below the nav,
         not inside the hero's pt-16/24 wrapper, so it sits visually
         centered between the nav bar and the headline. Sweep is L→R
         (reading direction). Twinkling sparkles flank the text. -->
    <div class="reveal mt-10 sm:mt-14 flex items-center justify-center gap-3">
      <span class="text-accent-300 text-sm animate-[twinkle_3s_ease-in-out_infinite]">✦</span>
      <span class="text-sm sm:text-base font-semibold uppercase tracking-[0.22em]
                   bg-gradient-to-r from-accent-200 via-accent-400 via-50% to-accent-200
                   bg-[length:200%_auto] bg-clip-text text-transparent
                   animate-[shine_6s_linear_infinite]">
        Built by Ziad Haboush
      </span>
      <span class="text-accent-300 text-sm animate-[twinkle_3s_ease-in-out_infinite]" style="animation-delay: 1.5s;">✦</span>
    </div>

    <!-- Hero content -->
    <div class="max-w-5xl mx-auto px-6 pt-10 sm:pt-14 pb-12 sm:pb-14 text-center">
      <!-- Eyebrow chip -->
      <div class="reveal inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] text-base-300 mb-7 tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-tier-strong animate-pulse"></span>
        Local-first · No telemetry · Multi-industry
      </div>

      <!-- Headline — staggered reveal with DAMN doing a dramatic shout
           animation (scale punch + glow burst). The h1-stagger / h1-word
           / h1-damn classes are wired in global.css and triggered by the
           IntersectionObserver in BaseLayout. -->
      <h1 class="reveal h1-stagger text-5xl sm:text-7xl md:text-8xl font-semibold tracking-tighter leading-[0.95] mb-7 max-w-4xl mx-auto">
        <span class="h1-word">Find</span>
        <span class="h1-word">me</span>
        <span class="h1-word">some</span>
        <span class="h1-damn bg-gradient-to-r from-accent-300 via-accent-400 to-accent-600 bg-clip-text text-transparent">damn</span>
        <span class="h1-word">jobz.</span>
      </h1>

      <!-- Subhead -->
      <p class="reveal text-lg sm:text-xl text-base-300 max-w-2xl mx-auto leading-relaxed mb-10">
        AI-powered job search that actually fits. Pulls <strong class="text-base-100">thousands of roles</strong> from major job boards, scores each one against <strong class="text-base-100">your resume</strong>, and surfaces the matches worth <strong class="text-base-100">your time</strong>. Built for any industry. AI, Tech, Tax, Engineering, Healthcare, Real Estate, Science, you name it.
      </p>

      <!-- v0.2.3: switched from 1 auto-detected button → 3 explicit
           buttons. Old design SSR'd a Windows-default href and swapped
           it client-side via JS — but a Mac user clicking before the JS
           ran got the .exe (which macOS can't open). Now every user
           sees their actual platform's download as a labeled button,
           no JS dependency, no race condition.

           The auto-detect JS at the bottom of this file is still here
           but it now just *highlights* the most-likely button (subtle
           ring) — never swaps an href. -->
      <div class="reveal flex items-center justify-center gap-3 flex-wrap">
        <a id="dl-windows" href={MSI_URL}
           class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
          <span>Download for Windows</span>
          <span class="text-[11px] opacity-70 font-normal">{APP_SIZE}</span>
        </a>
        <a id="dl-mac-arm64" href={DMG_ARM64_URL}
           class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <span>Download for Mac (2020 or newer)</span>
        </a>
        <a id="dl-mac-x64" href={DMG_X64_URL}
           class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <span>Download for Mac (Pre-2020 / Intel)</span>
        </a>
      </div>
      <div class="reveal mt-3 text-center">
        <a href="#how-it-works" class="text-[12px] text-base-500 hover:text-base-300 underline-offset-4 hover:underline">See how it works ↓</a>
      </div>

      <!-- Tiny helper for users unsure which Mac they have. Year split
           is fuzzy at the edges (a 2020 MacBook Pro 13" was Intel until
           Nov 2020), so we offer a definitive way to check via the
           Apple menu. -->
      <div class="reveal mt-4 text-[11px] text-base-600 text-center max-w-md mx-auto">
        Most Macs from 2020 onward are Apple Silicon (M1/M2/M3/M4). To check exactly: Apple menu → About This Mac → look at the "Chip" line.
      </div>

      <!-- Stats strip — stack on mobile (the big numbers like "Thousands"
           and "10–20 min" overflow each other in a 3-col layout below
           ~640px), three-up on sm and above. -->
      <div class="reveal-stagger mt-14 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 max-w-3xl mx-auto">
        <Stat number="Thousands" label="of roles per search" />
        <Stat number="10–20 min" label="per fresh search" />
        <Stat number="4-Stage" label="AI cascade logic" />
      </div>

      <div class="mt-6 text-[11px] text-base-500 uppercase tracking-widest">
        Windows 10/11 · macOS 12+
      </div>
    </div>
  </header>

