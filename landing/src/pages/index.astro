<style>
  /* Ensure gradient text doesn't wrap weirdly on small screens */
  h1 span { display: inline-block; }

  /* Native <select> dropdown styling — the closed state inherits the form's
   * dark glass aesthetic, but when the user clicks to open the option list,
   * browsers default to a white system panel. Without explicit option styles,
   * the inherited light-gray text becomes invisible on that white panel.
   *
   * Setting color-scheme on the select tells modern browsers to render the
   * dropdown panel in dark mode, and the option-level overrides force readable
   * contrast even on browsers that ignore color-scheme. Solid dark background
   * + bright text + small padding = clearly readable in every browser.
   */
  #feedback-form select {
    color-scheme: dark;
  }
  #feedback-form select option {
    background-color: #161922;
    color: #ebeef4;
    padding: 8px 12px;
  }
  #feedback-form select option:checked,
  #feedback-form select option:hover {
    background-color: #38405a;
    color: #ffffff;
  }
</style>

<script>
  // v0.2.3: switched from JS-rewrites-href model to 3-explicit-buttons.
  // The 3 download buttons (#dl-windows / #dl-mac-arm64 / #dl-mac-x64)
  // each have hardcoded SSR'd hrefs to their correct platform URL.
  // No href swapping, no race condition possible — even if this script
  // never runs, all 3 buttons work correctly.
  //
  // What this block STILL does (cosmetic only): subtly highlights the
  // button matching the user's detected platform with a ring + slight
  // scale, so first-time visitors don't have to read all 3 labels to
  // find theirs. If detection fails, no harm done — all buttons work.
  type Platform = "windows" | "mac-arm64" | "mac-x64";

  async function detectPlatform(): Promise<Platform | null> {
    const ua = navigator.userAgent || "";
    if (/Win/i.test(ua)) return "windows";
    if (/Mac/i.test(ua)) {
      const uaData = (navigator as any).userAgentData;
      if (uaData?.getHighEntropyValues) {
        try {
          const hints = await uaData.getHighEntropyValues(["architecture"]);
          if (hints?.architecture === "x86") return "mac-x64";
          if (hints?.architecture === "arm") return "mac-arm64";
        } catch { /* fall through */ }
      }
      return "mac-arm64"; // best guess for Safari/Firefox on modern Macs
    }
    return null; // unknown OS — leave all 3 buttons un-highlighted
  }

  detectPlatform().then((platform) => {
    if (!platform) return;
    const idByPlatform: Record<Platform, string> = {
      "windows": "dl-windows",
      "mac-arm64": "dl-mac-arm64",
      "mac-x64": "dl-mac-x64",
    };
    const btn = document.getElementById(idByPlatform[platform]) as HTMLAnchorElement | null;
    if (btn) {
      btn.classList.add("ring-2", "ring-accent-400/60", "shadow-lg");
    }
  });

  // ==========================================================
  // Feedback form — POSTs to api.findmesomedamnjobz.com/v1/feedback
  // (the same Worker that serves installer downloads + LLM proxy).
  // No auth, no UUID — Worker rate-limits anonymous posts by IP.
  // ==========================================================
  const FEEDBACK_URL = "https://api.findmesomedamnjobz.com/v1/feedback";
  const fbForm = document.getElementById("feedback-form") as HTMLFormElement | null;
  if (fbForm) {
    const messageEl = document.getElementById("fb-message") as HTMLTextAreaElement;
    const countEl = document.getElementById("fb-count") as HTMLElement;
    const hintEl = document.getElementById("fb-hint") as HTMLElement;
    const statusEl = document.getElementById("fb-status") as HTMLElement;
    const submitBtn = document.getElementById("fb-submit") as HTMLButtonElement;
    const submitLabel = document.getElementById("fb-submit-label") as HTMLElement;

    // Live character count + min/max hint colorization
    const updateCount = () => {
      const n = messageEl.value.trim().length;
      countEl.textContent = `${n.toLocaleString()} / 10,000`;
      if (n === 0) {
        hintEl.textContent = "10–10,000 characters";
        hintEl.className = "text-base-500";
      } else if (n < 10) {
        hintEl.textContent = `Need at least ${10 - n} more characters`;
        hintEl.className = "text-amber-400";
      } else if (n > 10000) {
        hintEl.textContent = "Too long — trim it down";
        hintEl.className = "text-red-400";
      } else {
        hintEl.textContent = "Specifics help. Steps to reproduce, role + company, what you expected.";
        hintEl.className = "text-base-500";
      }
    };
    messageEl.addEventListener("input", updateCount);

    fbForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const category = (document.getElementById("fb-category") as HTMLSelectElement).value;
      const message = messageEl.value.trim();
      const email = (document.getElementById("fb-email") as HTMLInputElement).value.trim();

      if (message.length < 10 || message.length > 10000) return;

      submitBtn.disabled = true;
      submitLabel.textContent = "Sending...";
      statusEl.textContent = "";
      statusEl.className = "text-[11px] text-base-500 leading-snug min-h-[1.2em]";

      try {
        const res = await fetch(FEEDBACK_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            source: "website",
            category,
            message,
            email: email || undefined,
            page_url: window.location.href,
          }),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          let msg = "Couldn't send — try again?";
          if (res.status === 429) msg = "You've hit the daily limit. Try again tomorrow.";
          else if (body?.error) msg = body.error.replace(/_/g, " ");
          throw new Error(msg);
        }
        // Success state — replace the form contents with a thank-you
        fbForm.innerHTML = `
          <div class="text-center py-8">
            <div class="w-12 h-12 mx-auto rounded-full bg-tier-strong/15 border border-tier-strong/40 flex items-center justify-center mb-4">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgb(94 234 212)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
            </div>
            <h3 class="text-lg font-medium mb-1.5">Thanks — we got it.</h3>
            <p class="text-sm text-base-400">If you left an email, we'll reach out if there's a follow-up question.</p>
          </div>
        `;
      } catch (err: any) {
        statusEl.textContent = String(err?.message || "Couldn't send — try again?");
        statusEl.className = "text-[11px] text-red-300 leading-snug min-h-[1.2em]";
        submitBtn.disabled = false;
        submitLabel.textContent = "Send feedback";
      }
    });
  }
</script>
