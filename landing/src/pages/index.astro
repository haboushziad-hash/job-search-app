      <span class="text-accent-300 text-sm animate-[twinkle_3s_ease-in-out_infinite]" style="animation-delay: 1.5s;">✦</span>
    </div>

    <!-- Hero content -->
    <div class="max-w-5xl mx-auto px-6 pt-10 sm:pt-14 pb-12 sm:pb-14 text-center">
