<script>
  // Platform auto-detect for download CTAs.
  //
  // Detection precedence:
  //   1. Windows  — userAgent contains "Win"
  //   2. Mac arm64 — userAgentData.architecture === "arm" (Chromium only)
  //   3. Mac      — userAgent contains "Mac" but architecture unknown.
  //                 Default to arm64 (covers ~95% of 2020+ Macs); Intel
  //                 users click the visible "Mac (Intel)" escape hatch.
  //   4. Other    — leave SSR Windows default in place (linux/mobile users
  //                 typically know what they want; the "Other" row is visible).
  //
  // Why we don't hide the alternatives:
  //   Browsers lie about Mac arch — Safari always says "Intel Mac". The
  //   only reliable arm-vs-x64 signal is userAgentData.getHighEntropyValues
  //   which is Chrome/Edge only. So Safari users on Apple Silicon get a
  //   guess + a visible escape hatch. Hiding it = breaking Intel Macs.
  type Platform = "windows" | "mac-arm64" | "mac-x64";

  async function detectPlatform(): Promise<Platform> {
    const ua = navigator.userAgent || "";
    if (/Win/i.test(ua)) return "windows";
    if (/Mac/i.test(ua)) {
      // Best-effort arch sniff via Chromium client hints. Returns null
      // on Safari/Firefox — we fall back to arm64 since 2020+ Macs are.
      const uaData = (navigator as any).userAgentData;
      if (uaData?.getHighEntropyValues) {
        try {
          const hints = await uaData.getHighEntropyValues(["architecture"]);
          if (hints?.architecture === "x86") return "mac-x64";
          if (hints?.architecture === "arm") return "mac-arm64";
        } catch {
          /* ignore — fall through to default */
        }
      }
      return "mac-arm64";
    }
    return "windows"; // unknown — keep SSR default
  }

  function applyPlatform(platform: Platform) {
    const labelByPlatform: Record<Platform, string> = {
      "windows": "Download for Windows",
      "mac-arm64": "Download for Mac",
      "mac-x64": "Download for Mac (Intel)",
    };
    const headlineByPlatform: Record<Platform, string> = {
      "windows": "Download for Windows",
      "mac-arm64": "Download for Mac",
      "mac-x64": "Download for Mac (Intel)",
    };
    const subheadByPlatform: Record<Platform, string> = {
      "windows": "Version 0.1.0 · Windows 10 or 11.",
      "mac-arm64": "Version 0.1.0 · macOS 12+ (Apple Silicon).",
      "mac-x64": "Version 0.1.0 · macOS 12+ (Intel).",
    };

    // Primary buttons — swap href + label
    document.querySelectorAll<HTMLAnchorElement>("#hero-download, #cta-download").forEach((btn) => {
      const url = btn.dataset[`url${platform.replace(/-/g, "_")}` as any]
        || btn.dataset.urlWindows
        || btn.dataset[
          platform === "mac-arm64" ? "urlMacArm64" :
          platform === "mac-x64" ? "urlMacX64" :
          "urlWindows"
        ];
      if (url) btn.href = url;
    });

    // Hero label
    document.querySelectorAll<HTMLSpanElement>("[data-download-label]").forEach((el) => {
      el.textContent = labelByPlatform[platform];
    });

    // Bottom CTA section copy
    document.querySelectorAll<HTMLElement>("[data-cta-headline]").forEach((el) => {
      el.textContent = headlineByPlatform[platform];
    });
    document.querySelectorAll<HTMLElement>("[data-cta-subhead]").forEach((el) => {
      el.textContent = subheadByPlatform[platform];
    });

    // Rewrite the "Other downloads" row to be contextual:
    //   - Detected Windows → show "On a Mac? Apple Silicon · Intel"
    //   - Detected Mac arm64 → show "On Windows or Intel Mac? Windows · Mac (Intel)"
    //   - Detected Mac x64  → show "On Windows or Apple Silicon? Windows · Mac (Apple Silicon)"
    // Hides the platform that matches the big button, so it isn't a duplicate.
    const prefixByPlatform: Record<Platform, string> = {
      "windows": "On a Mac?",
      "mac-arm64": "On Windows or Intel Mac?",
      "mac-x64": "On Windows or Apple Silicon?",
    };
    const prefixEl = document.querySelector<HTMLElement>("[data-other-prefix]");
    if (prefixEl) prefixEl.textContent = prefixByPlatform[platform];

    // Hide the auto-picked platform's link (it's already the big button).
    // Also hide whichever separator becomes adjacent to nothing.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-platform]"));
    const seps = Array.from(document.querySelectorAll<HTMLElement>("[data-sep]"));
    links.forEach((link) => {
      if (link.dataset.platform === platform) link.style.display = "none";
    });
    // After hiding, recompute which separators sit between two visible links
    const visibleLinks = links.filter((l) => l.style.display !== "none");
    seps.forEach((sep) => {
      // sep at index i sits between links[i] and links[i+1]
      const idx = parseInt(sep.dataset.sep || "-1", 10);
      const before = links[idx];
      const after = links[idx + 1];
      const beforeVisible = before && before.style.display !== "none";
      const afterVisible = after && after.style.display !== "none";
      sep.style.display = beforeVisible && afterVisible ? "" : "none";
    });
    // Final: if only one visible link remains, the prefix becomes "On a Mac?
    // Apple Silicon" (singular) — drop the now-trailing separator already
    // handled above. No extra work needed.
    void visibleLinks;
  }

  detectPlatform().then(applyPlatform);
</script>
