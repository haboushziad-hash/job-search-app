---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stat from "../components/Stat.astro";
import Step from "../components/Step.astro";
import Feature from "../components/Feature.astro";
import PrivacyChip from "../components/PrivacyChip.astro";

// Production downloads stream through the Cloudflare Worker, which checks
// the request Origin/Referer is findmesomedamnjobz.com before serving the
// .msi/.dmg from a private R2 bucket. The bare URLs are not directly
// shareable — pasting them into a fresh tab returns 403.
const MSI_URL = import.meta.env.PUBLIC_MSI_URL || "https://api.findmesomedamnjobz.com/v1/dl/windows";
const DMG_ARM64_URL = import.meta.env.PUBLIC_DMG_ARM64_URL || "https://api.findmesomedamnjobz.com/v1/dl/mac-arm64";
const DMG_X64_URL = import.meta.env.PUBLIC_DMG_X64_URL || "https://api.findmesomedamnjobz.com/v1/dl/mac-x64";
const VERSION = "0.1.0";
const APP_SIZE = "107 MB";
---
<BaseLayout>
  <!-- ======================================================== HERO -->
  <header class="relative overflow-hidden">
    <!-- Cursor spotlight — soft purple glow that tracks the mouse position
         behind the hero. Visual position is set via CSS vars --mx and --my
         updated by the script at the bottom of this file. Falls back to
         hidden when JS is off. -->
    <div id="hero-spotlight" class="cursor-spotlight" aria-hidden="true"></div>
    <!-- Top nav -->
    <nav class="max-w-6xl mx-auto px-6 pt-8 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <!-- Z mark — same PNG as the app icon (z-mark.png in /public,
             generated by `tauri icon` from the source 2048×2048). -->
        <img src="/z-mark.png" alt="findmesomedamnjobz" width="32" height="32"
             class="shadow-lg shadow-accent-900/40 rounded-lg" />
        <span class="font-semibold tracking-tight text-base-100 text-sm">findmesomedamnjobz</span>
      </div>
      <div class="hidden sm:flex items-center gap-1">
        <a href="#how-it-works" data-nav-target="how-it-works" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">How it works</a>
        <a href="#features" data-nav-target="features" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">Features</a>
        <a href="#privacy" data-nav-target="privacy" class="nav-link px-3 py-1.5 text-sm text-base-300 hover:text-base-100">Privacy</a>
      </div>
      <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;"
         class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-white/[0.06] border border-white/[0.08] text-sm text-base-100 hover:bg-white/[0.10] transition-colors">
        Download
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>

    <!-- Built-by credit (animated gradient) — placed just below the nav,
         not inside the hero's pt-16/24 wrapper, so it sits visually
         centered between the nav bar and the headline. Sweep is L→R
         (reading direction). Twinkling sparkles flank the text. -->
