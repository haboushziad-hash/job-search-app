# Job Search App — Environment Variables
# ------------------------------------------------------------------
# Copy this file to ".env" (in the same folder) and fill in real values.
# The .env file is gitignored and never committed or shared.
# ------------------------------------------------------------------

# Google AI Studio API keys (Gemini)
# Get one at: https://aistudio.google.com/app/apikey
# You can configure multiple keys (each from a separate Google Cloud project)
# to multiply your daily Pro quota. All bill to the same account.
GOOGLE_API_KEY=paste-your-google-api-key-here
# Optional additional keys for higher daily quota (each adds 1000 Pro/day):
# GOOGLE_API_KEY_2=paste-second-key-here
# GOOGLE_API_KEY_3=paste-third-key-here

# Cloudflare Account ID (NOT a secret — just an account identifier)
# Find at: https://dash.cloudflare.com → right sidebar → "Account ID"
CLOUDFLARE_ACCOUNT_ID=paste-your-cloudflare-account-id-here

# Admin dashboard password (you'll set this — used to log into your private dashboard)
ADMIN_DASHBOARD_PASSWORD=change-me-to-something-strong

# Spend caps (USD) — proxy enforces these
PER_CALL_CAP_USD=2.00
PER_RUN_CAP_USD=5.00
PER_LICENSE_MONTHLY_CAP_USD=20.00
GLOBAL_MONTHLY_CAP_USD=100.00

# Dev mode (true = use local SQLite, log verbosely)
DEV_MODE=true
