# Job Search App — environment configuration template
# Copy to .env and fill in your keys.

# ============================================================
# REQUIRED — LLM scoring keys (one of these stacks)
# ============================================================

# Option 1: Bring your own LLM keys (LOCAL mode)
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
ANTHROPIC_API_KEY=

# Option 2: Use Ziad's central server (CENTRAL mode — for testers)
# When LLM_PROXY_URL is set, the keys above are NOT used. The desktop app
# routes all LLM calls through Ziad's Cloudflare Worker which holds the
# real keys server-side. Testers don't see keys; Ziad covers all costs.
LLM_PROXY_URL=
AUDIT_UPLOAD_URL=
TESTER_UUID=          # auto-generated by frontend on first launch

# ============================================================
# JOB BOARD APIs — all optional, enable each by adding the key
# ============================================================

# USAJOBS — federal jobs API. Free, requires registration.
# Sign up: https://developer.usajobs.gov/  (~30 seconds)
# Once registered, paste your key + email below.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=haboushziad@gmail.com

# Adzuna — aggregator API (pulls from ZipRecruiter, Monster, CareerBuilder, etc.)
# Free tier: 1,000 calls/month. Sign up at https://developer.adzuna.com/signup
# After signup you get APP_ID (public) and APP_KEY (secret).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# The Muse — curated job board with broad employer mix.
# API key is OPTIONAL but raises rate limits if you have one.
# Sign up: https://www.themuse.com/developers
THEMUSE_API_KEY=

# Remotive — all remote jobs. NO key required.

# BuiltIn — tech-adjacent and consumer roles. NO key required.

# Serper.dev — Google Jobs aggregator. Reaches every employer Google has
# indexed (pharma/biotech/retail/etc.) PLUS LinkedIn/Indeed/Glassdoor.
# Free tier: 2,500 calls/month (vs SerpAPI's 100/mo at $25). Sign up at
# https://serper.dev/  → "Get free API key". 402 = monthly cap reached.
SERPER_API_KEY=

# ============================================================
# COST CAPS (USD)
# ============================================================
# Tripped if a run/call exceeds these. Defaults are conservative.
PER_CALL_CAP_USD=2.00
PER_RUN_CAP_USD=5.00
PER_LICENSE_MONTHLY_CAP_USD=20.00
GLOBAL_MONTHLY_CAP_USD=100.00

# ============================================================
# DEV
# ============================================================
DEV_MODE=false
