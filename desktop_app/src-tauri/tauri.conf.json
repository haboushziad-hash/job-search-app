{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "findmesomedamnjobz",
  "version": "0.3.18",
  "identifier": "app.jobsearch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "findmesomedamnjobz",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.findmesomedamnjobz.com/v1/update/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NTI2RUREREZGNzg2MEYKUldRUGh2ZmYzVzVTUmJlOER3N3RnQk4rMUNRQWNMaEdqSEhLL0FCczVRRUtnYTE5ZzlSaE9JSnQK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Ziad Haboush",
    "category": "Productivity",
    "shortDescription": "Find roles that actually match.",
    "longDescription": "An AI-powered job search tool that scrapes thousands of roles, scores them against your resume, and surfaces the best matches across multiple tiers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/backend"],
    "resources": [],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  }
}
