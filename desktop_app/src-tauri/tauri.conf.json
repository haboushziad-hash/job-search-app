{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Job Search",
  "version": "0.1.0",
  "identifier": "app.jobsearch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Job Search",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Ziad Haboush",
    "category": "Productivity",
    "shortDescription": "Find roles that actually match.",
    "longDescription": "An AI-powered job search tool that scrapes thousands of roles, scores them against your resume, and surfaces the best matches across multiple tiers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/backend"],
    "resources": [],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
